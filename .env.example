# ------------------------------------------------------------------
# Copia este archivo como .env.local y completa los valores reales.
# El archivo .env.local esta en .gitignore: NUNCA lo subas a Git.
# ------------------------------------------------------------------

# URL del proyecto Supabase (Dashboard > Connect > Framework)
# Se expone al navegador: es publico.
VITE_SUPABASE_URL=https://tu-ref-de-proyecto.supabase.co

# Publishable key (sb_publishable_...)
# Se expone al navegador: es publica y esta disenada para eso.
# Dashboard > Project Settings > API Keys > Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key (sb_secret_...)
# SIN prefijo VITE_: nunca llega al bundle del navegador.
# Solo la usan los scripts de Node (seed, migraciones).
SUPABASE_SECRET_KEY=sb_secret_...

# Connection string de Postgres para correr las migraciones.
# Dashboard > Connect > Direct > Session pooler (puerto 5432).
# Usamos el pooler porque la conexion directa es solo IPv6.
DATABASE_URL=postgresql://postgres.TU_REF:TU_CONTRASENIA@aws-0-TU_REGION.pooler.supabase.com:5432/postgres